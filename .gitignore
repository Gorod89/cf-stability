.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# raw data and extracted events never go into git (highD licence forbids redistribution; the rest is large)
data/raw/
data/events/
# calibrations (5 MB) and split files are part of the reproducibility record and stay

# hydra output directories
outputs/
multirun/

# run outputs: weights (*.pt, 60 MB), results (*.json), tables, figures and the SUMO scenarios are kept, and
# so are the per-event closed-loop metrics of every run (test_events.parquet, 82 MB; transfer_*.parquet,
# 65 MB), which the paired statistics of the tables read, the three heterogeneous corridor laws
# (runs/corridor/laws/*.npz, 0.4 MB) and the compact figure inputs (fields.npz); the simulated
# trajectories (3.5 GB), logs and queue locks are not
runs/**/*.npz
!runs/corridor/scenarios/**
!runs/corridor/laws/*.npz
!runs/**/fields.npz
runs/**/*.parquet
!runs/**/test_events.parquet
!runs/**/transfer_*.parquet
runs/**/*.log
runs/**/_queue.lock

# the MDPI template as downloaded (its Definitions/ is copied to paper/Definitions)
paper/MDPI_Article_Template__4_/
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz

# the manuscript and the journal template are not published in this repository
paper/
